<!-- PrismJS syntax highlighting scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/autoloader/prism-autoloader.min.js" defer></script>
<script>
document.addEventListener("DOMContentLoaded", function () {
    function initPrism() {
        if (typeof Prism === "undefined") {
            setTimeout(initPrism, 20);
            return;
        }

        Prism.languages.coldfusion = {
            'comment': [
                /<!--[\s\S]*?-->/,
                /<!---[\s\S]*?--->/,
                /\/\/.*/,
                /\/\*[\s\S]*?\*\//
            ],
            'string': {
                pattern: /(["'])(?:(?!\1)[^\\]|\\.)*\1/,
                greedy: true
            },
            'tag': {
                pattern: /<\/?cf[a-z0-9_]+(?:\s+[^>]*)?\/?>/i,
                inside: {
                    'tag': {
                        pattern: /^<\/?cf[a-z0-9_]+/i,
                        inside: {
                            'punctuation': /^<\/?/,
                            'namespace': /^cf/i
                        }
                    },
                    'attr-value': {
                        pattern: /=\s*(?:(["'])(?:(?!\1)[^\\]|\\.)*\1|[^\s>]+)/i,
                        inside: {
                            'punctuation': [/^=/, /^["']|["']$/]
                        }
                    },
                    'keyword': /\b(?:eq|neq|lt|lte|gt|gte|and|or|not|is|contains)\b/i,
                    'attr-name': /[\w-]+(?=\s*=)/i,
                    'punctuation': /\/?>/
                }
            },
            'variable': /#[\w.()]+#|\b(?:variables|arguments|session|application|request|cgi|form|url|cookie|local|this)\b/i,
            'keyword': /\b(?:cfset|cfif|cfelseif|cfelse|cfoutput|cfloop|cffunction|cfargument|cfreturn|cfcomponent|cfproperty|cftry|cfcatch|cffinally|cfthrow|cflocation|cfquery|cfqueryparam|cfinclude|cfdump|var|if|else|elseif|for|while|do|in|switch|case|default|break|continue|return|function|try|catch|finally|throw|new|eq|neq|lt|lte|gt|gte|and|or|not|is|contains)\b/i,
            'boolean': /\b(?:true|false|yes|no)\b/i,
            'number': /\b\d+(?:\.\d+)?\b/,
            'operator': /[+\-*\/%&|!=<>]+/,
            'punctuation': /[{}\[\];(),.:]/
        };
        Prism.languages.cfml = Prism.languages.coldfusion;
        if (Prism.languages.javascript) {
            Prism.languages.cfscript = Prism.languages.javascript;
        }
        Prism.highlightAll();
    }
    initPrism();
});
</script>
