{% macro navLinks() %}
    <li><a href="{{ '/' | url }}" class="nav-flag"><span class="sr-only">Home</span> <span class="nav-flag-text">--home</span></a></li>
    <li><a href="{{ '/' | url }}#about" class="nav-flag"><span class="sr-only">About</span> <span class="nav-flag-text">--about</span></a></li>
    <li class="nav-dropdown">
        <button type="button" class="dropdown-toggle nav-flag" aria-expanded="false" aria-haspopup="true">
            <span class="sr-only">Writing archive</span>
            <span class="nav-flag-text">--writing</span>
            <i class="ph ph-caret-down dropdown-arrow" aria-hidden="true"></i>
        </button>
        <ul class="dropdown-menu">
            <li><a href="{{ '/blog/' | url }}"><i class="ph ph-article" aria-hidden="true"></i><span>Blog</span></a></li>
            <li><a href="{{ '/articles/' | url }}"><i class="ph ph-newspaper" aria-hidden="true"></i><span>Articles</span></a></li>
            <li><a href="{{ '/presentations/' | url }}"><i class="ph ph-chalkboard" aria-hidden="true"></i><span>Presentations</span></a></li>
            <li><a href="{{ '/wheels-series/' | url }}"><i class="ph ph-gear" aria-hidden="true"></i><span>Wheels Series</span></a></li>
        </ul>
    </li>
    <li><a href="{{ '/' | url }}#career" class="nav-flag"><span class="sr-only">Career</span> <span class="nav-flag-text">--career</span></a></li>
    <li><a href="{{ '/' | url }}#contact" class="nav-flag"><span class="sr-only">Contact</span> <span class="nav-flag-text">--contact</span></a></li>
    <li><a href="{{ '/search/' | url }}" class="nav-flag"><span class="sr-only">Search</span> <span class="nav-flag-text">--search</span></a></li>
{% endmacro %}

{% macro footerLinks() %}
    <a href="{{ '/' | url }}" class="footer-link">Home</a>
    <span class="footer-separator" aria-hidden="true">•</span>
    <a href="{{ '/' | url }}#about" class="footer-link">About</a>
    <span class="footer-separator" aria-hidden="true">•</span>
    <a href="{{ '/' | url }}#career" class="footer-link">Career</a>
    <span class="footer-separator" aria-hidden="true">•</span>
    <a href="{{ '/blog/' | url }}" class="footer-link">Blog</a>
    <span class="footer-separator" aria-hidden="true">•</span>
    <a href="{{ '/' | url }}#contact" class="footer-link">Contact</a>
{% endmacro %}
